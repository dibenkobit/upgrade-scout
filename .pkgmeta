# Read by the BigWigsMods packager (https://github.com/BigWigsMods/packager), which builds the
# release archive and uploads it to CurseForge when a version tag is pushed
# (.github/workflows/release.yml).

package-as: UpgradeScout

# The addon is the UpgradeScout folder; nothing else in the repository belongs in the archive.
move-folders:
  UpgradeScout/UpgradeScout: UpgradeScout

ignore:
  - tests
  - scripts
  - docs
  - README.md
  - CHANGELOG.md
  - RELEASE_NOTES.md
  - LICENSE

# The notes shown with a release on CurseForge and on GitHub: the section of CHANGELOG.md for the
# version being released. The release workflow writes this file before the packager runs; it is
# not kept in the repository.
manual-changelog:
  filename: RELEASE_NOTES.md
  markup-type: markdown

# Shown on CurseForge; its app installs Pawn together with this addon.
required-dependencies:
  - pawn
