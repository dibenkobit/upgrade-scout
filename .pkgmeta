# Read by the BigWigsMods packager (https://github.com/BigWigsMods/packager), which builds the
# release archive and uploads it to CurseForge and Wago Addons when a version tag is pushed
# (.github/workflows/release.yml).

package-as: UpgradeScout

# The addon is the UpgradeScout folder; nothing else in the repository belongs in the archive.
move-folders:
  UpgradeScout/UpgradeScout: UpgradeScout

ignore:
  - tests
  - scripts
  - docs
  - .luacheckrc
  - README.md
  - CHANGELOG.md
  - RELEASE_NOTES.md
  - LICENSE

# Pawn can score gear in place of the addon's own weights (UpgradeScout/Pawn.lua; the .toc names
# it in "## OptionalDeps"). Listed here by its CurseForge slug, it is set on every file uploaded
# there as an optional dependency, which CurseForge shows among the relations of both projects.
# The packager sends relations to CurseForge only.
optional-dependencies:
  - pawn

# The notes shown with a release on CurseForge and on GitHub: the section of CHANGELOG.md for the
# version being released. The release workflow writes this file before the packager runs; it is
# not kept in the repository.
manual-changelog:
  filename: RELEASE_NOTES.md
  markup-type: markdown
